{%- comment -%} v1 · cm-our-services LP · Ao seu dispor · CSS via saibai-conditional-assets {%- endcomment -%}
<!-- saibai-asvc-v1 -->

{%- liquid
  assign asvc_title = section.settings.title | default: 'Ao seu dispor'
-%}

<section class="saibai-asvc" aria-label="{{ asvc_title | escape }}">
  <div class="saibai-asvc__inner">
    <h2 class="saibai-asvc__title">{{ asvc_title }}</h2>

    <div class="saibai-asvc__grid">
      {%- for block in section.blocks -%}
        <article class="saibai-asvc__item" {{ block.shopify_attributes }}>
          <div class="saibai-asvc__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg viewBox="0 0 64 64" focusable="false" role="presentation">
                  <path d="M8 42h36V18H8v24Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M44 26h10l6 8v8H44V26Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="18" cy="44" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="50" cy="44" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              {%- when 'returns' -%}
                <svg viewBox="0 0 64 64" focusable="false" role="presentation">
                  <path d="M14 18h36v28H14V18Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M22 26h20M22 34h14" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M38 38l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              {%- when 'whatsapp' -%}
                <svg viewBox="0 0 64 64" focusable="false" role="presentation">
                  <path d="M18 14h28v36H18V14Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M26 22h12M26 30h12M26 38h8" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M42 42l8 8" fill="none" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 64 64" focusable="false" role="presentation">
                  <circle cx="32" cy="32" r="18" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M32 22v10l6 6" fill="none" stroke="currentColor" stroke-width="1.5"/>
                </svg>
            {%- endcase -%}
          </div>

          {%- if block.settings.label != blank -%}
            <p class="saibai-asvc__label">{{ block.settings.label }}</p>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a
              href="{{ block.settings.link_url }}"
              class="saibai-asvc__link"
              {% if block.settings.link_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
            >
              {{ block.settings.link_label }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Saibai At Service",
  "class": "saibai-at-service-section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Ao seu dispor"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Serviço",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Entrega" },
            { "value": "returns", "label": "Troca" },
            { "value": "whatsapp", "label": "Atendimento" },
            { "value": "calendar", "label": "Agenda" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Título do serviço",
          "default": "Entrega refrigerada"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto do link",
          "default": "Saiba mais"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Saibai At Service",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "shipping",
            "label": "Entrega refrigerada",
            "link_label": "Como entregamos",
            "link_url": "/pages/politica-de-entrega"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "returns",
            "label": "Troca facilitada",
            "link_label": "Política de troca",
            "link_url": "/pages/politica-de-troca"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "whatsapp",
            "label": "Grupo VIP WhatsApp",
            "link_label": "Entrar no grupo",
            "link_url": "https://chat.whatsapp.com/LmGiN0C8QT04AQ4VB9PDdO"
          }
        }
      ]
    }
  ]
}
{% endschema %}
