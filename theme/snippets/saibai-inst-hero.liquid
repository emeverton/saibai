{%- comment -%} Empório Saibai — Hero institucional (foto + título abaixo) {%- endcomment -%}
{%- liquid
  assign hero_title = section.settings.title
  assign hero_lead = section.settings.lead

  if request.page_type == 'article' and article.title != blank
    assign hero_title = article.title
    if hero_lead == blank and article.excerpt != blank
      assign hero_lead = article.excerpt | strip_html | strip | truncate: 180
    endif
  elsif request.page_type == 'blog' and section.settings.title == blank and blog.title != blank
    assign hero_title = blog.title
  endif

  assign hero_img_alt = hero_title | escape
  if section.settings.image != blank
    assign hero_use_picker = true
  elsif section.settings.asset_fallback != blank
    assign hero_asset = section.settings.asset_fallback
  else
    assign hero_asset = 'saibai-inst-campo.webp'
  endif
-%}
<section class="saibai-inst-hero" data-saibai-inst-hero aria-label="{{ hero_title | escape }}">
  <div class="saibai-inst-hero__stage">
    <div class="saibai-inst-hero__frame">
      <div class="saibai-inst-hero__media">
        {%- if hero_use_picker -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '800, 1200, 1600',
              sizes: '(min-width: 990px) 86rem, 100vw',
              class: 'saibai-inst-hero__img',
              alt: hero_img_alt
          }}
        {%- else -%}
          <img
            class="saibai-inst-hero__img"
            src="{{ hero_asset | asset_url }}"
            alt="{{ hero_img_alt }}"
            width="1600"
            height="900"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>
    </div>

    <div class="saibai-inst-hero__box">
      <div class="saibai-inst-hero__box-body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="saibai-inst-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="saibai-inst-hero__title">{{ hero_title }}</h1>
        {%- if hero_lead != blank -%}
          <p class="saibai-inst-hero__lead">{{ hero_lead }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
