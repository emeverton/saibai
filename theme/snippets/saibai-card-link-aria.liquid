{%- comment -%}
  Empório Saibai — aria-label acessível para links de card (badge dentro do <a>)
  Veltrus Growth & Technology | Shopify Partner ID 4969609
{%- endcomment -%}
{%- liquid
  assign cp = card_product
  assign label = cp.title | escape
  assign badge_note = ''

  if cp.available == false and settings.show_sold_out_badge
    assign badge_note = 'Esgotado'
  elsif cp.compare_at_price > cp.price and settings.show_sale_badge
    assign badge_note = 'Promoção'
  else
    if settings.show_new_badge
      assign is_new = false
      assign new_badge_type = settings.new_badge_type
      if new_badge_type == 'auto'
        assign date_start = cp.created_at | date: '%s'
        assign date_now = 'now' | date: '%s'
        assign date_difference = date_now | minus: date_start | divided_by: 86400
        if date_difference < settings.new_badge_time
          assign is_new = true
        endif
      else
        for tag in cp.tags
          assign tag_handle = tag | handle
          if tag_handle == 'new'
            assign is_new = true
            break
          endif
        endfor
      endif
      if is_new
        assign badge_note = 'Novo'
      endif
    endif

    if badge_note == '' and settings.show_custom_badge
      assign custom_text = cp.metafields.custom.custom_badge
      if custom_text != blank
        assign badge_note = custom_text | escape
      endif
    endif
  endif

  if badge_note != ''
    assign label = label | append: ' — ' | append: badge_note
  endif
-%}
{{- label -}}
