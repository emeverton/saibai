{%- comment -%} Empório Saibai — pages consolidado por template {%- endcomment -%}
{%- capture page_list -%}saibai-pages-base.css{%- endcapture -%}
{%- case template.name -%}
  {%- when 'collection' -%}
    {%- capture page_list -%}{{ page_list }},saibai-pages-collection.css{%- endcapture -%}
  {%- when 'product' -%}
    {%- capture page_list -%}{{ page_list }},saibai-pages-pdp-buybox.css,saibai-pages-pdp-media.css,saibai-pages-pdp-content.css{%- endcapture -%}
  {%- when 'cart' -%}
    {%- capture page_list -%}{{ page_list }},saibai-pages-cart.css{%- endcapture -%}
  {%- when 'search', 'blog', 'article', 'list-collections' -%}
    {%- capture page_list -%}{{ page_list }},saibai-pages-light.css{%- endcapture -%}
  {%- when 'page' -%}
    {%- capture page_list -%}{{ page_list }},saibai-pages-static.css{%- endcapture -%}
{%- endcase -%}
{%- if template.directory == 'customers' -%}
  {%- capture page_list -%}{{ page_list }},saibai-pages-customer.css{%- endcapture -%}
{%- endif -%}
{%- assign page_files = page_list | split: ',' -%}
{%- for file in page_files -%}
  {%- if async -%}
    <link rel="stylesheet" href="{{ file | asset_url }}" media="print" onload="this.media='all'">
  {%- else -%}
    {{ file | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endfor -%}
{%- if async -%}
  <noscript>
    {%- for file in page_files -%}
      {{ file | asset_url | stylesheet_tag }}
    {%- endfor -%}
  </noscript>
{%- endif -%}
