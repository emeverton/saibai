{%- comment -%} v4 · editorial LP · 3 cards lifestyle · saibai-ed-v2 {%- endcomment -%}
<!-- saibai-ed-v4 -->
<section class="saibai-ed" aria-label="Coleções Saibai">
  <div class="saibai-ed__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_label = block.settings.label
        assign card_title = block.settings.title
        assign card_url = block.settings.url
        assign card_cta = block.settings.cta
        assign card_style = block.settings.style | default: 'product'
        assign card_image = block.settings.image
        assign card_asset = block.settings.image_asset
        assign card_alt = block.settings.image_alt | default: card_title
      -%}

      <article class="saibai-ed__card saibai-ed__card--{{ card_style }}" {{ block.shopify_attributes }}>
        <div class="saibai-ed__tile">
          <a href="{{ card_url }}" class="saibai-ed__media">
            <span class="saibai-ed__media-inner">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1024
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 558, 780, 1024',
                    sizes: '(min-width: 990px) calc((min(90rem, 100vw - 4rem) - 2 * 2rem) / 3), 78vw',
                  class: 'saibai-ed__img',
                  alt: card_image.alt | default: card_alt
                }}
              {%- elsif card_asset != blank -%}
                <img
                  src="{{ card_asset | asset_url }}"
                  alt="{{ card_alt | escape }}"
                  class="saibai-ed__img"
                  loading="lazy"
                  width="854"
                  height="1196"
                >
              {%- endif -%}
            </span>
          </a>
          <div class="saibai-ed__info">
            {%- if card_label != blank -%}
              <p class="saibai-ed__label">{{ card_label }}</p>
            {%- endif -%}
            {%- if card_title != blank -%}
              <h3 class="saibai-ed__name">
                <a href="{{ card_url }}">{{ card_title }}</a>
              </h3>
            {%- endif -%}
            {%- if card_cta != blank -%}
              <span class="saibai-ed__cta">{{ card_cta }}</span>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Saibai Editorial",
  "class": "saibai-editorial-section",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection",
      "name": "Coleção",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Estilo da imagem",
          "options": [
            { "value": "lifestyle", "label": "Lifestyle (cover)" },
            { "value": "product", "label": "Produto (contain)" }
          ],
          "default": "product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Eyebrow",
          "default": "Safra 2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Coleção"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Texto do link",
          "default": "Descobrir"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Asset fallback (assets/)",
          "default": "saibai-ed-fresca.webp"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt da imagem"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Saibai Editorial",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "style": "lifestyle",
            "label": "Safra 2026",
            "title": "Alcachofra Fresca",
            "cta": "Comprar",
            "url": "/collections/alcachofra-in-natura",
            "image_asset": "saibai-feature-fresca.webp",
            "image_alt": "Alcachofra fresca colhida em Piedade, SP"
          }
        },
        {
          "type": "collection",
          "settings": {
            "style": "product",
            "label": "Artesanal",
            "title": "Conservas",
            "cta": "Descobrir",
            "url": "/collections/em-conserva",
            "image_asset": "saibai-ed-conserva.webp",
            "image_alt": "Conserva artesanal Saibai — coração de alcachofra"
          }
        },
        {
          "type": "collection",
          "settings": {
            "style": "lifestyle",
            "label": "Gourmet",
            "title": "Flores Desidratadas",
            "cta": "Descobrir",
            "url": "/collections/flores-desidratadas",
            "image_asset": "saibai-banner-flores-hero.webp",
            "image_alt": "Flores desidratadas Saibai em composição gourmet"
          }
        },
        {
          "type": "collection",
          "settings": {
            "style": "product",
            "label": "Souvenir",
            "title": "Chaveiro Saibai",
            "cta": "Descobrir",
            "url": "/collections/chaveiro",
            "image_asset": "saibai-ed-chaveiro.webp",
            "image_alt": "Chaveiro artesanal Saibai em formato de alcachofra"
          }
        }
      ]
    }
  ]
}
{% endschema %}
