<style>
  .saibai-feature { display: flex; align-items: stretch; gap: 0; max-width: 100%; overflow: hidden; }
  .saibai-feature__media { flex: 1 1 50%; min-height: 500px; background: url('https://cdn.shopify.com/s/files/1/0923/8193/7982/files/SAIBAI_2.png?v=1778069195') center/cover no-repeat; order: 2; }
  .saibai-feature__content { flex: 1 1 50%; display: flex; flex-direction: column; justify-content: center; padding: 60px 48px; background: var(--saibai-light, #F4F9F0); order: 1; }
  .saibai-feature__eyebrow { color: var(--saibai-primary, #76BD22); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 12px; }
  .saibai-feature__title { color: var(--saibai-dark, #2A3A1A); margin: 0 0 16px; }
  .saibai-feature__text { color: var(--saibai-dark-muted, #4E6040); line-height: 1.7; margin: 0 0 24px; max-width: 42ch; }
  .saibai-feature__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; background: var(--saibai-primary, #76BD22); color: #fff; border-radius: 4px; text-decoration: none; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .saibai-feature__cta:hover { background: var(--saibai-primary-hover, #5A9018); color: #fff; }
  .saibai-feature__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .saibai-feature__cta--outline { background: transparent; color: var(--saibai-dark, #2A3A1A); border: 2px solid var(--saibai-secondary, #4E7E8A); }
  .saibai-feature__cta--outline:hover { background: var(--saibai-secondary, #4E7E8A); color: #fff; }
  @media (max-width: 767px) {
    .saibai-feature { flex-direction: column; }
    .saibai-feature__content { order: 1; padding: 40px 20px; }
    .saibai-feature__media { order: 2; min-height: 300px; flex: none; width: 100%; }
  }
</style>
<div class="saibai-feature page-width page-width--full">
  <div class="saibai-feature__content">
