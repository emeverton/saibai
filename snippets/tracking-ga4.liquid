{%- endcomment -%}
{%- if settings.ga4_measurement_id != blank -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
  <script defer>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ settings.ga4_measurement_id }}', { send_page_view: true });

    {%- if request.page_type == 'product' and product -%}
    gtag('event', 'view_item', {
      currency: '{{ cart.currency.iso_code }}',
      value: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
      items: [{
        item_id: {{ product.id | json }},
        item_name: {{ product.title | json }},
        price: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
        quantity: 1
      }]
    });
    {%- endif -%}

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[name="add"], .add-to-cart-button, .quick-add__submit');
      if (!btn || btn.disabled) return;
      var form = btn.closest('form[action*="/cart/add"]');
      var card = btn.closest('.saibai-product-card');
      var productId = form && form.querySelector('[name="id"]') ? form.querySelector('[name="id"]').value : '';
      gtag('event', 'add_to_cart', {
        currency: '{{ cart.currency.iso_code }}',
        items: [{ item_id: productId || 'unknown', quantity: 1 }]
      });
    });

    document.addEventListener('click', function (e) {
      var checkout = e.target.closest('[name="checkout"], a[href*="/checkout"]');
      if (!checkout) return;
      gtag('event', 'begin_checkout', { currency: '{{ cart.currency.iso_code }}' });
    });
  </script>
{%- endif -%}
