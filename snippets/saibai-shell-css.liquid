{%- comment -%} Empório Saibai — shell modular (substitui saibai-shell.css) {%- endcomment -%}
{%- capture shell_list -%}saibai-shell-kv.css,saibai-shell-cards-media.css,saibai-shell-cards-body.css,saibai-shell-cards-grid.css,saibai-shell-layout.css,saibai-shell-cta.css{%- if saibai_skip_veltrus_base -%},saibai-shell-legacy.css{%- endif -%}{%- endcapture -%}
{%- assign shell_files = shell_list | split: ',' -%}
{%- for file in shell_files -%}
  {%- if async -%}
    <link rel="stylesheet" href="{{ file | asset_url }}" media="print" onload="this.media='all'">
  {%- else -%}
    {{ file | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endfor -%}
{%- if async -%}
  <noscript>
    {%- for file in shell_files -%}
      {{ file | asset_url | stylesheet_tag }}
    {%- endfor -%}
  </noscript>
{%- endif -%}
