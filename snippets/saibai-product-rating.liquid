{%- comment -%}
  Empório Saibai — Rating unificado (Shopify + Judge.me + apps)
  Veltrus Growth & Technology | Shopify Partner ID 4969609
{%- endcomment -%}
{%- liquid
  assign rating_product = product | default: closest.product
  assign rating_value = blank
  assign rating_count = blank
  assign rating_scale_max = 5

  if rating_product != blank
    assign standard_rating = rating_product.metafields.reviews.rating.value
    assign standard_count = rating_product.metafields.reviews.rating_count
    if standard_count == blank
      assign standard_count = rating_product.metafields.reviews.rating_count.value
    endif

    if standard_rating != blank and standard_count != blank
      assign rating_value = standard_rating.rating
      assign rating_count = standard_count
      assign rating_scale_max = standard_rating.scale_max | default: 5
    endif

    if rating_value == blank and rating_product.metafields.loox.avg_rating != blank and rating_product.metafields.loox.num_reviews != blank
      assign rating_value = rating_product.metafields.loox.avg_rating
      assign rating_count = rating_product.metafields.loox.num_reviews
    endif

    if rating_value == blank and rating_product.metafields.yotpo.reviews_average != blank and rating_product.metafields.yotpo.reviews_count != blank
      assign yotpo_count = rating_product.metafields.yotpo.reviews_count | plus: 0
      if yotpo_count > 0
        assign rating_value = rating_product.metafields.yotpo.reviews_average
        assign rating_count = yotpo_count
      endif
    endif

    if rating_value == blank and rating_product.metafields.stamped.reviews_average != blank and rating_product.metafields.stamped.reviews_count != blank
      assign stamped_count = rating_product.metafields.stamped.reviews_count | plus: 0
      if stamped_count > 0
        assign rating_value = rating_product.metafields.stamped.reviews_average
        assign rating_count = stamped_count
      endif
    endif

    if rating_value == blank
      assign okendo_summary = rating_product.metafields.okendo.summaryData.value | default: rating_product.metafields.okendo.summaryData
      if okendo_summary.reviewCount != blank
        assign okendo_count = okendo_summary.reviewCount | plus: 0
        if okendo_count > 0
          assign rating_value = okendo_summary.reviewAverageValue
          assign rating_count = okendo_count
        endif
      elsif rating_product.metafields.okendo.ReviewCount != blank
        assign okendo_count = rating_product.metafields.okendo.ReviewCount | plus: 0
        if okendo_count > 0
          assign rating_value = rating_product.metafields.okendo.ReviewAverageValue
          assign rating_count = okendo_count
        endif
      endif
    endif

    if rating_value == blank and rating_product.metafields.junip.rating_average != blank and rating_product.metafields.junip.rating_count != blank
      assign junip_count = rating_product.metafields.junip.rating_count | plus: 0
      if junip_count > 0
        assign rating_value = rating_product.metafields.junip.rating_average
        assign rating_count = junip_count
      endif
    endif
  endif

  assign show_rating = false
  if rating_value != blank and rating_count != blank
    assign rating_count_num = rating_count | plus: 0
    if rating_count_num > 0
      assign show_rating = true
    endif
  endif

  if show_rating
    assign decimal = rating_value | modulo: 1
    assign decimal_rating = 0
    if decimal >= 0.3 and decimal <= 0.7
      assign decimal_rating = 0.5
    elsif decimal > 0.7
      assign decimal_rating = 1
    endif
    assign decimal_rounded = decimal_rating | ceil
    assign svg_filled_stars = rating_value | floor | plus: decimal_rounded
  endif

  assign reviews_anchor = anchor_id | default: 'saibai-pdp-avaliacoes'
-%}

{%- if show_rating -%}
  <div class="saibai-rating{% if class != blank %} {{ class }}{% endif %}" aria-label="{{ 'content.rating' | t: rating: rating_value | round: 1 }}">
    {%- if link_to_reviews -%}
      <a class="saibai-rating__link" href="#{{ reviews_anchor }}">
    {%- endif -%}
    <span class="saibai-rating__stars" aria-hidden="true">
      {%- for star in (1..rating_scale_max) -%}
        <span class="saibai-rating__star{% if star <= svg_filled_stars %} saibai-rating__star--full{% elsif decimal_rating == 0.5 and star == svg_filled_stars %} saibai-rating__star--half{% endif %}">★</span>
      {%- endfor -%}
    </span>
    <span class="saibai-rating__score">{{ rating_value | round: 1 }}</span>
    <span class="saibai-rating__count">({{ rating_count }} {{ 'content.reviews' | t }})</span>
    {%- if link_to_reviews -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
