{%- comment -%}
  Saibai Empório — Logo fallback
  Desenvolvido por Veltrus Growth & Technology
  variant: default | inverse
{%- endcomment -%}
{%- liquid
  assign logo_variant = variant | default: 'default'
  if logo_variant == 'inverse'
    assign logo_asset = 'logo-saibai-inverse.svg'
  else
    assign logo_asset = 'logo-saibai.svg'
  endif
  assign logo_width = width | default: 200
  assign logo_height = height | default: 43
-%}
<img
  src="{{ logo_asset | asset_url }}"
  alt="{{ shop.name | escape }}"
  class="header-logo__image saibai-logo{% if class != blank %} {{ class }}{% endif %}"
  width="{{ logo_width }}"
  height="{{ logo_height }}"
  loading="eager"
  fetchpriority="high"
>
