{%- comment -%}
  Empório Saibai — Tema Oficial
  Desenvolvido por Veltrus Growth & Technology
  Shopify Partner ID: 4969609
  Versão: 1.0.0 | 2025
  PROPRIEDADE INTELECTUAL PROTEGIDA
  Reprodução proibida sem autorização
{%- endcomment -%}
<style>
  :root {
    --saibai-primary: #8ABE0A;
    --saibai-primary-hover: #7AAA08;
    --saibai-secondary: #4E7E8A;
    --saibai-dark: #2A3A1A;
    --saibai-light: #F2F5EE;
    --saibai-white: #FFFFFF;
  }

  html {
    scrollbar-gutter: stable;
  }

  html, body {
    margin: 0;
    overflow-x: clip;
    max-width: 100vw;
  }

  /* Popups LGPD/cupom — zero altura no fluxo antes do CSS do módulo */
  .shopify-section.section-saibai-consent,
  .shopify-section.section-saibai-coupon {
    margin: 0;
    padding: 0;
    height: 0;
    min-height: 0;
    overflow: visible;
    border: 0;
  }

  .saibai-consent,
  .saibai-coupon {
    position: fixed;
    inset: 0;
    display: flex !important;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    contain: layout style;
  }

  body {
    font-family: var(--font-body--family, 'Jost', sans-serif);
    color: var(--saibai-dark);
    background: var(--saibai-light);
  }

  /* Modal aberto — não cortar header/barra fixa */
  body.overflow-hidden {
    overflow-x: clip;
    overflow-y: hidden;
  }

  body.overflow-hidden #header-group {
    overflow: visible;
  }

  #header-group {
    position: sticky;
    top: 0;
    z-index: 30;
    width: 100%;
    max-width: 100vw;
    overflow: visible;
    background: transparent;
  }

  #header-group .section-announcement-bar {
    overflow: visible;
    margin: 0;
    padding: 0;
  }

  .saibai-header-section {
    overflow: visible;
  }

  .slideshow:not(media-gallery),
  .slideshow-component,
  .section-slideshow,
  [class*="slide_height-full"] {
    min-height: 100vh;
    min-height: 100svh;
    position: relative;
    overflow: hidden;
  }

  .slideshow:not(media-gallery) .banner__media,
  .slideshow:not(media-gallery) .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slideshow:not(media-gallery) img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content-for-layout {
    min-height: 50vh;
  }

  /* Hero LCP — reserva espaço + poster instantâneo (home não carrega base.css Veltrus) */
  .template-index .saibai-hero__frame {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: #1a2412;
  }

  .template-index .saibai-hero__cover {
    background: #1a2412 center/cover no-repeat;
    background-image: url('{{ 'saibai-hero-fresca-480.webp' | asset_url }}');
  }

  @media (min-width: 550px) {
    .template-index .saibai-hero__cover {
      background-image: url('{{ 'saibai-hero-fresca-800.webp' | asset_url }}');
    }
  }

  @media (min-width: 990px) {
    .template-index .saibai-hero__cover {
      background-image: url('{{ 'saibai-hero-fresca-1920.webp' | asset_url }}');
    }
  }

  .template-index .saibai-hero__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* PLP / busca — cards estáveis (sem base.css Veltrus — Fase 2e) */
  body.saibai-theme:is(.template-collection, .template-search) .product-card-wrapper .card__media,
  body.saibai-theme:is(.template-collection, .template-search) .saibai-product-card .card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f8f8f8;
  }

  body.saibai-theme:is(.template-collection, .template-search) .product-card-wrapper .card__media img,
  body.saibai-theme:is(.template-collection, .template-search) .saibai-product-card .card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* PDP — grid 2 colunas antes do base.css async */
  body.saibai-theme.template-product .product-information__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  body.saibai-theme.template-product .product-information__media,
  body.saibai-theme.template-product .product-details {
    min-width: 0;
    width: 100%;
  }

  @media (min-width: 750px) {
    body.saibai-theme.template-product .product-information__grid:not(:has(.product-information__media:empty)) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
