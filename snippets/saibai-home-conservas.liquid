<style>
  .saibai-conservas { display: flex; align-items: stretch; gap: 0; max-width: 100%; overflow: hidden; }
  .saibai-conservas__media { flex: 1 1 50%; min-height: 420px; background: var(--saibai-accent, #9B8EC4) center/cover no-repeat; }
  .saibai-conservas__content { flex: 1 1 50%; display: flex; flex-direction: column; justify-content: center; padding: 60px 48px; background: var(--saibai-white, #fff); }
  .saibai-conservas__eyebrow { color: var(--saibai-secondary, #4E7E8A); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 12px; }
  .saibai-conservas__title { color: var(--saibai-dark, #2A3A1A); margin: 0 0 16px; }
  .saibai-conservas__text { color: var(--saibai-dark-muted, #4E6040); line-height: 1.7; margin: 0 0 24px; max-width: 42ch; }
  .saibai-conservas__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; background: var(--saibai-primary, #76BD22); color: #fff; border-radius: 4px; text-decoration: none; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .saibai-conservas__cta:hover { background: var(--saibai-primary-hover, #5A9018); color: #fff; }
  @media (max-width: 767px) {
    .saibai-conservas { flex-direction: column; }
    .saibai-conservas__content { order: 1; padding: 40px 20px; }
    .saibai-conservas__media { order: 2; min-height: 300px; flex: none; width: 100%; }
  }
</style>
<div class="saibai-conservas page-width page-width--full">
  <div class="saibai-conservas__content">
    <p class="saibai-conservas__eyebrow">Conservas artesanais</p>
    <h2 class="saibai-conservas__title">O sabor da alcachofra o ano inteiro</h2>
    <p class="saibai-conservas__text">Corações de alcachofra, antepastos e conservas preparados com receitas da família Saibai. Perfeitos para montar pratos especiais em minutos.</p>
    <a href="/collections/conservas" class="saibai-conservas__cta">Ver conservas</a>
  </div>
  <div class="saibai-conservas__media" style="background-color: var(--saibai-light, #F4F9F0);" role="img" aria-label="Conservas artesanais Saibai"></div>
</div>
